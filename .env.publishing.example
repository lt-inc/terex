# Copy to .env in the repository root; Docker Compose reads .env automatically.
# Current Google Cloud project: Terex Local (terex-local-510513).
# Import downloaded Web client JSON with scripts/Import-GoogleOAuth.ps1.
# Save the JSON at client creation: later downloads may not include the secret.
# Browser-visible Terex URL; Google callback is derived from this by main-be.
# Keep this URL without a trailing slash.
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback override, if configured by the deployment.
GOOGLE_REDIRECT_URL=http://localhost:3000/api/accounts/oauth/callback
# Future host (no DNS or deployment configured by this file):
# APP_PUBLIC_URL=https://terex.legendary-trio.me
# GOOGLE_REDIRECT_URL=https://terex.legendary-trio.me/api/accounts/oauth/callback
# Register that exact redirect in the Google Web client before switching.
# Authorized JavaScript origins are not used by the server-side OAuth flow.
WORKFLOW_GRPC_ADDR=:9091
MAIN_COORDINATOR_ADDR=main-be:9091
PUBLISHER_WORKERS=2
RENDER_REVISION_WORKERS=1
PUBLISH_INTERVAL=15s
