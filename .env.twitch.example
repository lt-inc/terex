# Copy values into your ignored .env. Use different random values for each secret.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
# Local Compose keeps the panel's Basic Auth. Staging uses FE_AUTH_MODE=traefik
# and receives its authenticated-user marker only from the Traefik middleware.
FE_AUTH_MODE=basic
TEREX_SERVICE_TOKEN=
COLLECTOR_SERVICE_TOKEN=
# Use a URL-safe random password (hex is convenient).
COLLECTOR_DB_PASSWORD=
# Twitch app client credentials; streamer OAuth is not used.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Existing Terex YouTube OAuth client. Connect the account through the UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/accounts/oauth/callback
APP_PUBLIC_URL=http://localhost:3000
S3_PUBLIC_ENDPOINT=localhost:9000
# Optional CPU-only worker for a Twitch-only pilot. Legacy YouTube/Whisper needs
# its existing host dependencies and mounts with the default worker image.
# GPU_DOCKERFILE=gpu-be/Dockerfile.twitch
# Cleanup starts in calculation mode; review Twitch > Storage before enabling.
TWITCH_CLEANUP_ENABLED=false
TWITCH_CLEANUP_INTERVAL=1h
# Staging supplies its internal Prometheus URL in k3s; local monitoring is optional.
TWITCH_STORAGE_PROMETHEUS_URL=
TWITCH_STORAGE_MIN_FREE_BYTES=1073741824
TWITCH_STORAGE_MIN_FREE_PERCENT=10
