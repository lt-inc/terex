# Copy values into your ignored .env. Use different random values for each secret.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
TEREX_SERVICE_TOKEN=
COLLECTOR_SERVICE_TOKEN=
# Use a URL-safe random password (hex is convenient).
COLLECTOR_DB_PASSWORD=
# Twitch app client credentials; streamer OAuth is not used.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Existing Terex YouTube OAuth client. Connect the account through the UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/accounts/oauth/callback
APP_PUBLIC_URL=http://localhost:3000
S3_PUBLIC_ENDPOINT=localhost:9000
# Optional CPU-only worker for a Twitch-only pilot. Legacy YouTube/Whisper needs
# its existing host dependencies and mounts with the default worker image.
# GPU_DOCKERFILE=gpu-be/Dockerfile.twitch
